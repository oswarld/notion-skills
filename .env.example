# sync에 필요한 설정 예시입니다. 비밀값과 일반 설정을 모두 포함합니다.
# .env가 없다면 이 파일을 복사하세요. .env는 Git 추적 대상에서 제외됩니다.
#
# bun run dry-run으로 검토한 뒤 동기화를 직접 실행합니다.
# 예약 실행용 GitHub Actions는 포함하지 않습니다.
# 브라우저에서 기본 스킬만 사용할 때는 토큰이 필요하지 않습니다.

# --- 인증 정보 --------------------------------------------------------------

# Skills Public API를 읽는 Notion 연결 토큰입니다. 필수 설정입니다.
# 게시할 스킬을 읽을 권한이 필요합니다. 연결의 접근 권한이 게시 범위입니다.
# 스킬별 게시 체크박스는 사용하지 않습니다.
# NOTION_API_TOKEN=ntn_xxx

# 대상 GitHub 저장소에 쓸 권한이 있는 토큰입니다.
# 설정하지 않으면 로컬 실행 시 gh auth token을 사용합니다.
# GITHUB_TOKEN=ghp_xxx

# --- 플러그인을 게시할 위치 --------------------------------------------------

# 동기화 대상 저장소를 소유자/저장소 형식으로 지정합니다. 필수 설정입니다.
# GITHUB_REPO=your-org/notion-skills
# 기록할 브랜치입니다. 기본값은 main입니다.
# GITHUB_BRANCH=main
# 커밋 작성자 정보입니다. 생략하면 기본 봇 정보를 사용합니다.
# GIT_AUTHOR_NAME=notion-skills-sync
# GIT_AUTHOR_EMAIL=notion-skills-sync@users.noreply.github.com

# --- Notion 환경 ------------------------------------------------------------

# prod(기본값), dev, stg 중 하나입니다. API 호스트와 플러그인 표시 파일에
# 기록하는 Notion 페이지 링크를 함께 바꿉니다.
# NOTION_ENV=prod

# 플러그인별 .notion-sync.json에 기록하며, 함께 추가되는 업데이트용 스킬이
# Notion 원본을 수정하는 방법을 안내할 때 사용합니다. 플러그인 조회에는 필요 없습니다.
# SKILLS_DATA_SOURCE_ID=

# --- 웹 서비스 운영자 설정 ---------------------------------------------------
# 위 CLI 동기화 인증 정보와 별도입니다. 일반 사용자는 Notion에 로그인하면 됩니다.
# 공개 OAuth 연결에 Read content 권한만 부여하고 다음 리디렉션 주소를 등록합니다.
#   https://skills.inlevel9.com/auth/notion/callback
# WEB_BASE_URL=https://skills.inlevel9.com
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# 세션 키 생성 명령: openssl rand -hex 32
# WEB_SESSION_KEY=
# 로컬 개발 시 WEB_BASE_URL에 http://localhost:3000을 사용할 수 있습니다.
